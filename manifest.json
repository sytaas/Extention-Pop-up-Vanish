{
  "manifest_version": 3,
  "name": "Zoho Busy Popup Killer",
  "version": "3.0",
  "description": "Auto closes Dialed number is busy popup in Zoho CRM",
  "permissions": ["scripting", "tabs"],
  "host_permissions": [
    "https://crm.zoho.in/*",
    "https://crm.zoho.com/*",
    "https://*.zoho.in/*",
    "https://*.zoho.com/*",
    "https://*.smartflo.tata.com/*",
    "https://*.smartflo.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "48": "icon.png"
  }
}
